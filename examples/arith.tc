// Exercises precedence, parentheses, unary minus, division and remainder.
//
// It is also the shortest way to see what the optimiser does, because none of
// these numbers is a secret: every operand traces back to a literal, so the
// whole program folds to the ten answers it prints and not one `add` survives.
//
//   tinyc examples/arith.tc --emit ir --no-optimise    # the arithmetic
//   tinyc examples/arith.tc --emit ir                  # the answers
//
// The pass that folds this is the same one that would refuse to: an operation
// whose answer does not fit stays an instruction, so the program still stops
// where it was written. Nothing here overflows, so nothing here survives.
fn main() {
  int a = 6;
  int b = 7;
  int c = 2;

  println(a + b * c);        // 6 + 14        = 20
  println((a + b) * c);      // 13 * 2        = 26
  println(-a + b);           // -6 + 7        = 1
  println(a * b - c * 100);  // 42 - 200      = -158
  println(a * b / c);        // 42 / 2        = 21
  println(100 / c / c);      // 50 / 2        = 25
  println(a * a + b * b + c * c);  // 36 + 49 + 4 = 89

  // `%` binds as tightly as `*` and `/`, and is the same `idiv` underneath —
  // read from rdx instead of rax.
  println(b % c);            // 7 % 2         = 1
  println(a + b % c);        // 6 + 1         = 7
  println(-b % c);           // -7 % 2        = -1, the sign follows the dividend
}
