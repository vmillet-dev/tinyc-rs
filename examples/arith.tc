// Exercises precedence, parentheses, unary minus, division and remainder.
// Each nested product becomes a temporary that dies as soon as it is consumed,
// so the register allocator reuses the same machine registers over and over.
fn main() {
  int a = 6;
  int b = 7;
  int c = 2;

  println(a + b * c);        // 6 + 14        = 20
  println((a + b) * c);      // 13 * 2        = 26
  println(-a + b);           // -6 + 7        = 1
  println(a * b - c * 100);  // 42 - 200      = -158
  println(a * b / c);        // 42 / 2        = 21
  println(100 / c / c);      // 50 / 2        = 25
  println(a * a + b * b + c * c);  // 36 + 49 + 4 = 89

  // `%` binds as tightly as `*` and `/`, and is the same `idiv` underneath —
  // read from rdx instead of rax.
  println(b % c);            // 7 % 2         = 1
  println(a + b % c);        // 6 + 1         = 7
  println(-b % c);           // -7 % 2        = -1, the sign follows the dividend
}
