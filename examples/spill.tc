// Twelve variables are all live at once when the sum starts, which is more than
// the nine allocatable registers: the allocator has to spill to the stack, and
// reuses each slot as soon as its value dies.
int v1 = 1;
int v2 = 2;
int v3 = 3;
int v4 = 4;
int v5 = 5;
int v6 = 6;
int v7 = 7;
int v8 = 8;
int v9 = 9;
int v10 = 10;
int v11 = 11;
int v12 = 12;
string done = "sum of 1..12:";
print(done);
print(v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12);  // 78
