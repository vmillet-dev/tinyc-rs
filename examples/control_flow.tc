// Conditionals and loops.

// if / else if / else. The condition must be a bool, which is what a
// comparison produces.
fn main() {
  int n = 7;
  if (n < 5) {
    println("small");
  } else if (n < 10) {
    println("medium");
  } else {
    println("large");
  }

  // while: the condition is re-tested at the top of every iteration.
  int i = 3;
  while (i > 0) {
    println(i);
    i = i - 1;
  }

  // for: init, condition, step. `j` exists only inside the loop.
  int total = 0;
  for (int j = 1; j <= 5; j = j + 1) {
    total = total + j;
  }
  println(total);        // 15

  bool big = total > 10;
  println(big);          // true

  // Nested loops, with an `if` inside.
  for (int a = 1; a <= 3; a = a + 1) {
    for (int b = 1; b <= 3; b = b + 1) {
      if (a == b) {
        println(a * 10 + b);   // 11, 22, 33
      }
    }
  }

  // break leaves the innermost loop; continue starts its next iteration.
  // In a `for`, the step still runs on the way past a `continue`.
  for (int c = 1; c <= 10; c = c + 1) {
    if (c == 2) {
      continue;            // 2 is never printed
    }
    if (c == 4) {
      break;               // and nothing past 3 is
    }
    println(c);              // 1, 3
  }

  // && and || are short-circuiting: the right operand runs only when the left
  // one has not already settled the answer. That is what makes this guard
  // work — `total / zero` is never evaluated.
  int zero = 0;
  if (zero != 0 && total / zero > 1) {
    println("unreachable");
  }
  println(zero == 0 || total / zero > 1);   // true, without dividing

  // && binds tighter than ||, and both bind looser than a comparison.
  println(1 < 2 && 2 < 3);   // true
  println(false || 5 > 9);   // false

  // `!` binds tighter than any binary operator, so `!ok && big` negates `ok`
  // alone. Negating a comparison inverts it rather than its result: `!(a < b)`
  // is compiled as `a >= b`, at no cost at all.
  bool ok = false;
  println(!ok);              // true
  println(!(total < 10));    // true
  for (int n = 1; n <= 6; n = n + 1) {
    if (!(n % 2 == 0)) {
      continue;            // odd numbers are skipped
    }
    println(n);              // 2, 4, 6
  }
}
