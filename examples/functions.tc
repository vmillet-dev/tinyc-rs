// Functions: parameters, return values, recursion and `void`.

// Parameters arrive in registers and become ordinary local variables.
fn add(int a, int b) -> int {
  return a + b;
}

// A function with no return type returns nothing. It can only be called as a
// statement, never used as a value.
fn banner(string title) {
  print("--------");
  print(title);
}

// Recursion works because signatures are collected before any body is checked,
// so `fib` is already visible inside `fib`.
fn fib(int n) -> int {
  if (n < 2) {
    return n;
  } else {
    return fib(n - 1) + fib(n - 2);
  }
}

// Loops, locals and parameters all mix freely.
fn factorial(int n) -> int {
  int result = 1;
  for (int i = 2; i <= n; i = i + 1) {
    result = result * i;
  }
  return result;
}

// Four parameters is the maximum: that is how many the ABI passes in registers.
fn sum4(int a, int b, int c, int d) -> int {
  return a + b + c + d;
}

// A call can be an argument to another call, and a `bool` is a value like any
// other.
fn is_even(int n) -> bool {
  return n / 2 * 2 == n;
}

fn main() {
  banner("arithmetic");
  print(add(20, 22));           // 42
  print(sum4(1, 2, 3, 4));      // 10
  print(add(add(1, 2), 3));     // 6

  banner("recursion");
  print(fib(10));               // 55
  print(factorial(10));         // 3628800

  banner("booleans");
  print(is_even(10));           // true
  print(is_even(7));            // false

  // A function may be called from inside a loop, and its frame is rebuilt each
  // time round.
  banner("the first fibonacci numbers");
  for (int i = 0; i < 8; i = i + 1) {
    print(fib(i));              // 0 1 1 2 3 5 8 13
  }
}
