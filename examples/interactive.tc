// Input: the first programs that do not know what they will be given.
//
// `read_line()` answers one line, without its ending — a `\n` on its own, or a
// `\r\n`, either way. `eof()` says whether there is anything left, and it says
// so *without consuming anything*, which is what makes the loop below read
// every line and ask for none that is not there.
//
// Asking for a line when there is none stops the program. That is deliberate:
// answering `""` would make an empty line and the end of the input the same
// value, and there would be no way to tell them apart afterwards.
//
// Everything the file gives is UTF-8; everything TinyC holds is characters. The
// decoding happens here, at the edge, and a byte sequence that spells no
// character stops the program rather than turning into a question mark.
//
// `is_int(s)` is the third built-in, and it exists for the same reason `eof()`
// does: `int(s)` stops the program on text that spells no number, and text that
// spells no number is *data* rather than a mistake in the program.

fn max_of(int[] xs) -> int {
  int best = xs[0];
  for (int i = 1; i < len(xs); i = i + 1) {
    if (xs[i] > best) {
      best = xs[i];
    }
  }
  return best;
}

fn sum_of(int[] xs) -> int {
  int total = 0;
  for (int i = 0; i < len(xs); i = i + 1) {
    total = total + xs[i];
  }
  return total;
}

// Nothing in this program says how many lines there will be, and nothing had
// to: the list grows to fit whatever arrives.
fn main() {
  int[] numbers = [];
  string[] words = [];

  while (!eof()) {
    string line = read_line();

    // An empty line is a line: it has a length, and it is not the end.
    if (len(line) == 0) {
      println("(blank)");
      continue;
    }

    // A line that spells a number is a number; anything else is a word.
    // `int(line)` stops the program on text that spells none, so this asks
    // first — the same bargain `eof()` strikes with `read_line()`.
    //
    // Checking it by hand would very nearly work, and the "very nearly" is the
    // point: a loop over the characters would take `-13` for a word, and it
    // would take twenty digits for a number right up until the conversion
    // stopped the program. Whether a number still fits can only be found out
    // by performing the overflow, which is why the language answers it.
    if (is_int(line)) {
      push(numbers, int(line));
      println("number " + line);
    } else {
      push(words, line);
      println("word " + line + " (" + string(len(line)) + " characters)");
    }
  }

  println("");
  println("numbers: " + string(len(numbers)));
  if (len(numbers) > 0) {
    println("sum: " + string(sum_of(numbers)));
    println("largest: " + string(max_of(numbers)));
  }
  println("words: " + string(len(words)));

  // The longest word, found without knowing how many there were.
  if (len(words) > 0) {
    string longest = words[0];
    for (int i = 1; i < len(words); i = i + 1) {
      if (len(words[i]) > len(longest)) {
        longest = words[i];
      }
    }
    println("longest: " + longest);
  }
}
