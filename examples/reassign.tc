// Variables can be reassigned, as long as the new value keeps their type.
fn main() {
  int n = 1;
  string label = "counting up:";
  println(label);
  println(n);
  n = n + 41;      // reads the old value, then becomes the new one
  println(n);        // 42
  n = n * n;
  println(n);        // 1764
  label = "done";
  println(label);
}
